    "    try:\n",
    "        catalog.validate()\n",
    "        print(\"✓ Catalog is valid!\")\n",
    "    except Exception as e:\n",
    "        print(f\"✗ Catalog validation failed: {e}\")\n",
    "    \n",
    "    # Save the catalog\n",
    "    print(\"\\n=== Saving Catalog ===\")\n",
    "    save_catalog(catalog)\n",
    "    \n",
